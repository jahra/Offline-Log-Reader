<UserControl x:Class="OfflineLogReader.LogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OfflineLogReader" x:Name="Root">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="190"/></Grid.RowDefinitions>
  <DataGrid x:Name="Rows" SelectionChanged="SelectionChanged">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="Čas" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:HighlightText Value="{Binding TimeText}" Query="{Binding Query, ElementName=Root}" MatchCase="{Binding MatchCase, ElementName=Root}" VerticalAlignment="Center" Padding="6,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Severity" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:HighlightText Value="{Binding Severity}" Query="{Binding Query, ElementName=Root}" MatchCase="{Binding MatchCase, ElementName=Root}" VerticalAlignment="Center" Padding="6,0" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Source" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:HighlightText Value="{Binding Source}" Query="{Binding Query, ElementName=Root}" MatchCase="{Binding MatchCase, ElementName=Root}" VerticalAlignment="Center" Padding="6,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Zpráva" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:HighlightText Value="{Binding Preview}" Query="{Binding Query, ElementName=Root}" MatchCase="{Binding MatchCase, ElementName=Root}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Padding="6,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#D9E0EA" Height="5"/>
  <Grid Grid.Row="2" Background="White">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="8,4">
    <Button DockPanel.Dock="Right" Content="Zobrazit v kontextu" Click="ContextClick"/>
    <Button DockPanel.Dock="Right" Content="Kopírovat záznam" Click="CopyClick"/>
    <TextBlock x:Name="Origin" VerticalAlignment="Center" Foreground="#526078" Text="Vyberte záznam pro zobrazení detailu" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <RichTextBox x:Name="Detail" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
  </Grid>
 </Grid>
</UserControl>

