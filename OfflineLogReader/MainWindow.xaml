<Window x:Class="OfflineLogReader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OfflineLogReader" Title="Offline Log Reader" Width="1380" Height="880" MinWidth="1000" MinHeight="650" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <ComboBox x:Name="EncodingChoice" SelectedIndex="0" Width="150" Margin="4" VerticalContentAlignment="Center"><ComboBoxItem Content="UTF-8"/><ComboBoxItem Content="Windows-1250"/></ComboBox>
    <Button x:Name="OpenButton" Content="＋ Přidat soubory" Click="OpenClick" Background="#2563EB" Foreground="White"/>
    <Button x:Name="ClearButton" Content="Zavřít soubory" Click="ClearClick"/>
   </StackPanel>
   <StackPanel><TextBlock Text="Offline Log Reader" FontSize="24" FontWeight="SemiBold" Foreground="#15233B"/><TextBlock x:Name="FileSummary" Text="Přetáhněte logy sem nebo zvolte Přidat soubory" Foreground="#61708A"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,12">
   <DockPanel x:Name="SearchPanel">
    <Button DockPanel.Dock="Right" Content="Find All ↗" Click="FindAllClick"/>
    <Button DockPanel.Dock="Right" Content="Další ↓" Click="NextClick"/>
    <Button DockPanel.Dock="Right" Content="Předchozí ↑" Click="PreviousClick"/>
    <CheckBox x:Name="SearchAll" DockPanel.Dock="Right" Content="Všechny záznamy" VerticalAlignment="Center" Margin="10,0" Checked="SearchChanged" Unchecked="SearchChanged"/>
    <CheckBox x:Name="SearchCase" DockPanel.Dock="Right" Content="Rozlišovat velikost" VerticalAlignment="Center" Margin="10,0" Checked="SearchChanged" Unchecked="SearchChanged"/>
    <TextBlock Text="Hledat  Ctrl+F" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <TextBox x:Name="SearchText" MinWidth="100" Margin="0" ToolTip="Enter: další shoda; Shift+Enter: předchozí shoda" TextChanged="SearchChanged" KeyDown="SearchKeyDown"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="6" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="FilterPanel">
      <TextBlock Text="FILTRY" FontWeight="Bold" Foreground="#61708A" Margin="0,0,0,12"/>
      <TextBlock Text="Od (datum a volitelně čas)"/><TextBox x:Name="FromText" ToolTip="dd.MM.yyyy HH:mm:ss"/>
      <TextBlock Text="Do (datum a volitelně čas)"/><TextBox x:Name="ToText" ToolTip="Samotné datum zahrnuje celý den"/>
      <TextBlock Text="Severity" FontWeight="SemiBold"/><TextBlock Text="Žádný výběr = všechny hodnoty" Foreground="#61708A" FontSize="11" Margin="0,2,0,6"/>
      <ListBox x:Name="SeverityList" SelectionMode="Multiple" Height="108"/>
      <TextBlock Text="Source" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox x:Name="SourceSearch" ToolTip="Vyhledat source v seznamu" TextChanged="SourceSearchChanged"/>
      <ListBox x:Name="SourceList" Height="150"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock Text="Vyloučit záznamy obsahující" FontWeight="SemiBold" Margin="0,14,0,2"/>
      <ItemsControl x:Name="ExclusionItems">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E0E5ED" BorderThickness="1" Padding="6" Margin="0,3">
         <StackPanel>
          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"/>
          <DockPanel><Button DockPanel.Dock="Right" Content="×" Padding="5,0" Margin="0" Click="RemoveExclusionClick" ToolTip="Odstranit filtr"/><CheckBox Content="Zapnutý" IsChecked="{Binding Enabled}" Margin="0,0,8,0"/><CheckBox Content="Aa" IsChecked="{Binding MatchCase}" ToolTip="Rozlišovat velikost písmen"/></DockPanel>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="＋ Vylučovací filtr" Click="AddExclusionClick" Margin="0,6,0,10"/>
      <Button Content="Použít filtry" Click="ApplyClick" Background="#2563EB" Foreground="White" Margin="0,3"/>
      <Button Content="Vymazat filtry" Click="ResetClick" Margin="0,3"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="6" ClipToBounds="True">
    <Grid><local:LogView x:Name="Log"/><TextBlock x:Name="EmptyHint" Text="Otevřete soubory a prohlížejte logy napříč dny.&#10;Veškerá data zůstávají na tomto počítači." TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#61708A" FontSize="16" IsHitTestVisible="False"/></Grid>
   </Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Zrušit operaci" Click="CancelClick" Visibility="Collapsed"/>
   <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="180" Height="7" Margin="14,0" Maximum="1" Visibility="Collapsed"/>
   <TextBlock x:Name="Status" Text="Připraveno" VerticalAlignment="Center" Foreground="#526078"/>
  </DockPanel>
 </Grid>
</Window>

